# Copy this file to .env and fill in your real values from
# Supabase → Project Settings → API. Never commit .env — it's
# already excluded in .gitignore.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# From Paystack → Settings → API Keys & Webhooks. Use the PUBLIC key here —
# never the secret key, which belongs only in the Edge Function's secrets,
# never in this file or anywhere in frontend code.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
